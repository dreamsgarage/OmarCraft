#!/bin/bash

# omarcraft: productivity tools on Omarchy, the ArtCraft Craft apps and more. Data and actions for the
# OmarCraft panel.
#
#   omarcraft state                 JSON for the panel: catalog, installed state, job, counts (local only)
#   omarcraft launch <id>           Launch (or focus) an installed app
#   omarcraft install <id>...       Install apps (prebuilt packages: a package repo or an AUR -bin) in a floating terminal
#   omarcraft install-group <g>     Install every missing app in a group: all, creative, 3d or office
#   omarcraft remove <id>...        Remove apps (their packages) in a floating terminal; files stay
#   omarcraft update [id...]        Update the given apps (default: all AUR apps with a newer build) in a floating
#                                   terminal; an app from a package repo opens Omarchy's system update instead
#   omarcraft job <verb> [id...]    The terminal side of install/update/system-update/remove; writes job.json
#   omarcraft check [--notify]      List installed apps with a newer build; exit 0 if any
#   omarcraft refresh [-f]          Fetch the catalog and versions (cached 24h, -f forces)
#   omarcraft list                  Print the catalog with install status
#   omarcraft missing [group]       Exit 0 if any app of the group is not installed
#   omarcraft seen                  Mark every catalog app as seen (clears "new"; the panel runs it on close)
#   omarcraft setup-menu            Opt in: add an ArtCraft section to the Omarchy menu
#   omarcraft remove-menu           Remove that section again
#
# Only prebuilt packages are ever installed, so nothing is compiled: packages a configured repo ships
# (Omarchy's own repo or the Arch repos) through omarchy-pkg-add, AUR -bin packages through Omarchy's
# omarchy-pkg-aur-add. Per-app AUR updates call the AUR helper Omarchy ships (yay); repo packages update
# with the system (omarchy-update). This script never elevates.

set -euo pipefail

SELF="$(realpath "${BASH_SOURCE[0]}")"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/omarcraft"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/omarcraft"
CATALOG="$CACHE_DIR/catalog.tsv"
# The cache's format; a cache without this marker is refreshed once, at once. 2 (0.5.4): the version
# column holds the AUR's version of every tool, where a repo tool's held the repo's. 3 (0.5.5): every
# field was checked and bounded on the way in; older caches may hold anything the network sent. 4 (0.5.6):
# a check also reads the repos as they are now (REPO_LATEST), so the first read after the update checks.
# 5 (0.5.7): a Craft app a repo also ships compares with the AUR's version (FOLLOW_APP_REPOS), so the
# badges for the newer AUR builds show at the first read instead of the next six-hourly check. 6 (0.5.8):
# ArtCraft's list in its new layout (17 apps, kind instead of group), so the new apps show at once.
CATALOG_FORMAT=6
CATALOG_FORMAT_FILE="$CACHE_DIR/catalog.format"
SYNC_CACHE="$CACHE_DIR/sync.tsv"
# The repos as they are now, not as of the last system update (see repo_check): a private copy of the
# package lists, and what it says of the catalog's packages.
REPO_DB="$CACHE_DIR/checkup-db"
REPO_LATEST="$CACHE_DIR/repo-latest.tsv"
# Read, never written: what decides whether the sync databases changed since SYNC_CACHE was made.
PACMAN_CONF=/etc/pacman.conf
PACMAN_SYNC_DIR=/var/lib/pacman/sync
REFRESH_FAILED="$CACHE_DIR/refresh-failed"
# Written when ArtCraft's list downloaded but no app in it could be read: its layout changed again. The
# built-in list is used meanwhile; check and list say so, the panel stays as it is.
PARSE_FAILED="$CACHE_DIR/catalog-parse-failed"
REFRESH_LOCK="$STATE_DIR/refresh.lock"
JOB_FILE="$STATE_DIR/job.json"
LAST_JOB_FILE="$STATE_DIR/last-job.json"
SEEN="$STATE_DIR/seen"
NOTIFIED="$STATE_DIR/notified-updates"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
# What 0.5.0 wrote for Vikunja, which 0.5.1 dropped; see legacy_vikunja_cleanup.
LEGACY_VIKUNJA_DIR="$DATA_HOME/omarcraft/vikunja"
LEGACY_VIKUNJA_ENTRY="$DATA_HOME/applications/vikunja-desktop.desktop"
LEGACY_VIKUNJA_PID="$STATE_DIR/vikunja-server.pid"
MENU_FILE="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
CATALOG_URL="https://raw.githubusercontent.com/storytold/craft-launcher/main/crates/core/src/catalog.rs"
AUR_RPC="https://aur.archlinux.org/rpc/v5/info"
# Everything read from the network is untrusted and bounded, from the download to each field kept from it
# (marketplace review of 0.5.4): a hostile or broken answer can neither fill memory nor reach the panel.
CATALOG_MAX_BYTES=262144        # the upstream catalog; 19 KB in 2026-11
AUR_MAX_BYTES=1048576           # one AUR answer for every tool; 10 KB in 2026-11
MAX_APPS=64                     # apps kept from the upstream catalog; 13 in 2026-11
NAME_MAX=48                     # characters in an app's name; the longest is 11
TAGLINE_MAX=96                  # characters in its tagline; the longest is 41
VERSION_RE='^[A-Za-z0-9._:+~-]{1,64}$'
COLOR_RE='^#[0-9a-f]{6}$'
IPC_TARGET="omarcraft.productivity"
CATALOG_MAX_AGE_MINUTES=360    # a check every six hours, like the panel's own timer (Service.qml)
REFRESH_RETRY_MINUTES=10        # after a failed check the panel retries on its own at most this often
# Deadlines (the marketplace review of 0.5.6, omacom/omarchy-plugin-marketplace#14528): a mirror that keeps
# sending just above pacman's low-speed limit could hold checkupdates, and with it the background check and
# its lock, for hours. checkupdates gets a total deadline; a background refresh as a whole gets another.
# Either way the previous answer is kept and the next check runs on time.
REPO_CHECK_SECONDS=120          # checkupdates, the whole run
REFRESH_DEADLINE_SECONDS=300    # a detached refresh: the list, the AUR and the repos together
# Install groups: the panel's three categories, plus all. notes is the Notes group of 0.2 to 0.5.7, merged
# into Office in 0.5.8; it stays as another name for office, so an Omarchy menu entry written earlier works.
GROUPS_RE='^(all|creative|3d|office|notes)$'
# Panel categories (0.5.8, the author's choice), shown in this order: Office, Creative and 3D Art; Craft
# Anything stands alone in the panel's footer (solo). Craft apps not listed here are Creative, so a new
# ArtCraft app shows up without a release of OmarCraft. MailCraft (a community app ArtCraft added on
# 2026-11-10, not packaged yet) is Office.
declare -A GROUP_OF=(
  [wordcraft]=office [gridcraft]=office [deckcraft]=office [pdfcraft]=office [typesetter]=office
  [memospot]=office [planify]=office [mailcraft]=office
  [cadcraft]=3d [solidcraft]=3d [texturecraft]=3d [materialcraft]=3d
  [craft-anything]=solo
)

# Where a tool comes from. A tool whose package a configured repo ships (Omarchy's own repo or the Arch
# repos) is a "repo" tool: the package manager and the AUR helper both take a name from a repo when one
# ships it, so the tool installs with omarchy-pkg-add and updates with the system, whatever installed it
# first. Any other tool is "aur": one package <id>-bin, desktop id ai.storyteller.<id>. KIND_OF pins the
# tools that only ever come from a repo. A tool may list several packages: the first is the app, the
# others install and remove with it.
declare -A KIND_OF=([typesetter]=repo [planify]=repo)
# Repos whose tools update one package at a time, like the AUR ones, after a dependency check, instead of
# with Omarchy's whole update (0.5.6, the author's decision): Omarchy's own repo, whose Craft packages are
# self-contained builds. Tools from the Arch repos keep updating with the system.
APP_REPOS_RE='^omarchy$'
# 0.5.7 (the author's decision, omacom/omarchy-pkgs#2390): a Craft app a repo also ships comes from the
# AUR, whose -bin packages follow ArtCraft's releases within hours, while the AUR has a build of it. 0 here
# keeps the repo-following code of 0.5.4 to 0.5.6 (kind repo, Omarchy's version, repo_update) switched
# off; 1 brings it back unchanged. Tools pinned in KIND_OF are not affected.
FOLLOW_APP_REPOS=0
KIND=""      # set by kind_var, the no-subshell form of kind_for
VERSION=""   # set by version_var
declare -A PKGS_OF=([typesetter]=typesetter [planify]=planify)
# Desktop ids that are not ai.storyteller.<id>: the tools beyond ArtCraft, and SolidCraft, a community app
# with its own publisher (its repo's assets/platforms/linux/io.tangencylabs.solidcraft.desktop).
declare -A DESKTOP_OF=(
  [memospot]=memospot [typesetter]=net.trowell.typesetter [planify]=io.github.alainm23.planify
  [solidcraft]=io.tangencylabs.solidcraft
)

# Glyphs (MDI range of the Nerd Font), checked by rendering; see docs/v1-design.md.
ICON_ARTCRAFT=$'\U000f03d8'
ICON_GROUP=$'\U000f01da'
ICON_UPDATE=$'\U000f0450'
ICON_NEW=$'\U0000f005'

# Built-in copy of the suite, used when upstream can't be reached:
# id<TAB>name<TAB>tagline<TAB>upstream group<TAB>brand colour<TAB>ink on light<TAB>ink on dark (ArtCraft's own).
BUILTIN_CATALOG="photocraft	PhotoCraft	Image editing	suite	#2f7bf5	#1a5bc4	#7fb0ff
vectorcraft	VectorCraft	Vector illustration	suite	#e8573f	#b83a24	#ff8a70
filmcraft	FilmCraft	Video editing, color and sound	suite	#8b5cf6	#6a3fd6	#b69cff
lightcraft	LightCraft	Photo library and raw development	suite	#f2a516	#8a5800	#ffc14d
pdfcraft	PdfCraft	Reading, organizing and protecting PDFs	suite	#e8204f	#b70228	#f23a62
effectcraft	EffectCraft	Motion graphics and visual effects	suite	#e0368f	#b0206c	#ff7ab8
designcraft	DesignCraft	Page layout and publishing	suite	#7bb51c	#457008	#a6e04a
figcraft	FigCraft	Interface design and prototyping	suite	#02da96	#047a56	#4fe8b6
wordcraft	WordCraft	Writing and document design	suite	#3f5fe0	#2a44b8	#8ea2ff
soundcraft	SoundCraft	Recording, editing and mixing audio	suite	#1fa5c9	#0e7290	#5fd0ee
deckcraft	DeckCraft	Presentations and slide shows	suite	#f07a1e	#a84f0a	#ffa060
cadcraft	CADCraft	Computer-aided design and drafting	suite	#3ea6e8	#1a6fa8	#7cc8ff
gridcraft	GridCraft	Spreadsheets and data	suite	#1f9d55	#12703a	#4fd68a
texturecraft	TextureCraft	3D texture painting	suite	#c2672b	#9c4a15	#e58a4e
materialcraft	MaterialCraft	Procedural material design	suite	#178a9c	#106573	#63c5d3
craft-anything	Craft Anything	Find out how any software works, then craft your own	suite	#4e7bfb	#1659c4	#74aaff
solidcraft	SolidCraft	Parametric 3D CAD	community	#46a1fb	#1653ae	#8cc4ff"
# Tools beyond ArtCraft, same columns, upstream group "extra". A tool qualifies when it has a stable
# desktop release, ships prebuilt (Arch repos or an AUR -bin) with a desktop entry, comes from a
# maintained open-source upstream, stays near ~150 MiB idle in one native process unless it adds
# something ArtCraft lacks, and works with others: its work can be shared and exported through an open
# format or a sync or sharing service the user chooses (see README, Beyond ArtCraft). Colours from each tool's icon; Typesetter's
# icon is grey, so it takes Typst's teal.
EXTRA_CATALOG="memospot	Memospot	Notes and journal: Memos on the desktop	extra	#f6b028	#9a6a08	#f6b028
typesetter	Typesetter	Typst documents with a live preview	extra	#239dad	#16707c	#5cc8d6
planify	Planify	Tasks and kanban boards, on your computer	extra	#3571e4	#2968e0	#7aa8ff"
CATALOG_COLUMNS=8   # id name tagline group version color ink-light ink-dark

declare -A APP_ICON=(
  [photocraft]=$'\U000f02e9' [vectorcraft]=$'\U000f0560' [filmcraft]=$'\U000f0567'
  [lightcraft]=$'\U000f0100' [pdfcraft]=$'\U000f0226' [effectcraft]=$'\U000f0068'
  [designcraft]=$'\U000f03d8' [wordcraft]=$'\U000f0219' [deckcraft]=$'\U000f0429'
  [gridcraft]=$'\U000f04eb' [cadcraft]=$'\U000f0eec' [soundcraft]=$'\U000f075a'
  [figcraft]=$'\U000f0001' [memospot]=$'\U000f11d7' [typesetter]=$'\U000f0284'
  [planify]=$'\U000f0576' [solidcraft]=$'\U000f01a7' [texturecraft]=$'\U000f00e3'
  [materialcraft]=$'\U000f1954' [craft-anything]=$'\U000f167a'
)
app_icon() {
  printf '%s' "${APP_ICON[$1]:-$ICON_ARTCRAFT}"
}

# The groups the panel shows. Upstream's classic/new stays in the catalog as data.
group_for() {
  printf '%s' "${GROUP_OF[$1]:-creative}"
}

# Every tool the plugin knows, built-in: the Craft suite and the extras.
builtin_rows() {
  printf '%s\n%s\n' "$BUILTIN_CATALOG" "$EXTRA_CATALOG"
}

die() {
  echo "omarcraft: $*" >&2
  exit 1
}

notify() {
  omarchy-notification-send --app-name OmarCraft "$@" &>/dev/null || true
}

poke_panel() {
  omarchy-shell -q "$IPC_TARGET" refresh &>/dev/null || true
  omarchy-menu refresh &>/dev/null || true
}

now_iso() {
  date -Iseconds
}

valid_id() {
  [[ $1 =~ ^[a-z0-9-]+$ ]] || die "invalid app id: $1"
}

# An id must be in the catalog before it can become a package name.
known_id() {
  valid_id "$1"
  catalog_rows | cut -d $'\037' -f1 | grep -qx "$1" || die "unknown app: $1 (see omarcraft list)"
}

# --- package repos ----------------------------------------------------------------------------
# What the configured repos ship of the catalog's packages, read from the local sync databases (no
# network): package -> repository and version, from the first repo that ships it, the one the package
# manager picks. Kept in SYNC_CACHE under a stamp of pacman.conf, the sync databases and the package list,
# and asked again only when the stamp changes, so most runs never start pacman for it. Loaded once per run.
declare -A SYNC_REPO=() SYNC_VERSION=()
SYNC_LOADED=0

# package<TAB>repository<TAB>version for each named package a repo ships, from the system's package lists
# or, with --dbpath DIR first, from another copy. LC_ALL=C because pacman translates its field names.
# Fails when pacman reports anything but a package no repo ships.
sync_table() {
  local out err db=()
  if [[ ${1:-} == --dbpath ]]; then db=(--dbpath "$2"); shift 2; fi
  out=$(mktemp)
  err=$(LC_ALL=C pacman -Si "${db[@]}" -- "$@" 2>&1 >"$out") || true
  awk -F' *: ' '$1 == "Repository" { r = $2 } $1 == "Name" { n = $2 }
    $1 == "Version" && !(n in seen) { seen[n]; print n "\t" r "\t" $2 }' "$out"
  rm -f "$out"
  [[ -z $(grep -v -e '^$' -e 'was not found' <<<"$err") ]]
}

load_sync() {
  (( SYNC_LOADED )) && return 0
  SYNC_LOADED=1
  local id pkg repo version pkgs=() dbs=() stamp="" head="" table="" tmp
  ensure_cache
  while IFS=$'\t' read -r id _; do
    [[ $id =~ ^[a-z0-9-]+$ ]] || continue
    pkg=${PKGS_OF[$id]:-$id-bin}
    pkgs+=("${pkg%% *}")
  done <"$CATALOG"
  (( ${#pkgs[@]} > 0 )) || return 0
  # No sync database where expected (a pacman.conf with its own DBPath): nothing tells when a sync
  # happened, so nothing is kept and every run asks.
  dbs=("$PACMAN_SYNC_DIR"/*.db)
  if [[ -e ${dbs[0]} ]]; then
    stamp=$(stat -c '%n %s %Y %i' -- "$PACMAN_CONF" "${dbs[@]}" 2>/dev/null || true)
    stamp="# ${stamp//$'\n'/ | } | ${pkgs[*]}"
  fi
  [[ -n $stamp && -f $SYNC_CACHE ]] && { IFS= read -r head <"$SYNC_CACHE" || true; }
  if [[ -n $stamp && $head == "$stamp" ]]; then
    table=$(<"$SYNC_CACHE")
  elif table=$(sync_table "${pkgs[@]}") && [[ -n $stamp ]]; then
    # Only a clean answer is kept; after any other error the next run asks again.
    tmp=$(mktemp "$SYNC_CACHE.XXXXXX")
    printf '%s\n%s\n' "$stamp" "$table" >"$tmp" && mv -f "$tmp" "$SYNC_CACHE"
  fi
  while IFS=$'\t' read -r pkg repo version; do
    [[ -n $pkg && $pkg != '#'* && -n $repo ]] || continue
    SYNC_REPO[$pkg]=$repo
    SYNC_VERSION[$pkg]=$version
  done <<<"$table"
}

# The AUR's version of each tool, from the catalog's version column: one read per run, read again after
# the catalog is rewritten (AUR_LOADED=0). Fields split on \x1f, not tab, so an empty column stays empty.
declare -A AUR_OF=()
AUR_LOADED=0

load_aur() {
  (( AUR_LOADED )) && return 0
  AUR_LOADED=1
  local id version
  [[ -f $CATALOG ]] || return 0
  while IFS=$'\037' read -r id _ _ _ version _; do
    [[ $id =~ ^[a-z0-9-]+$ && -n $version && $version =~ $VERSION_RE ]] && AUR_OF[$id]=$version
  done < <(tr '\t' '\037' <"$CATALOG")
  return 0
}

# The tool's kind, in the global KIND (no subshell): "repo" when it is pinned, or when a repo ships its
# package and either FOLLOW_APP_REPOS is on or the AUR has no build of it; "aur" otherwise.
kind_var() {
  local pkg=${PKGS_OF[$1]:-$1-bin}
  KIND=${KIND_OF[$1]:-}
  [[ -n $KIND ]] && return 0
  load_sync
  if [[ -n ${SYNC_REPO[${pkg%% *}]:-} ]]; then
    KIND=repo
    if (( ! FOLLOW_APP_REPOS )); then
      load_aur
      [[ -n ${AUR_OF[$1]:-} ]] && KIND=aur
    fi
  else
    KIND=aur
  fi
  return 0
}

# The name to give the AUR helper for an AUR package: aur/<pkg> when a repo ships the same name, since
# yay, like pacman, takes the repo's build otherwise (2026-11-06: a plain `yay -S wordcraft-bin`
# downgraded the AUR build to Omarchy's). The system's own lists decide, as they decide for yay.
aur_target() {
  load_sync
  if [[ -n ${SYNC_REPO[$1]:-} ]]; then printf 'aur/%s' "$1"; else printf '%s' "$1"; fi
}

# Installs AUR packages a repo also ships, by their aur/ name. omarchy-pkg-aur-add cannot take that name:
# its own last check runs `pacman -Q aur/<pkg>`, which always fails. Same steps otherwise: --needed, then
# a check that each package is there, on its plain name.
aur_install_shadowed() {
  local pkg targets=()
  for pkg in "$@"; do targets+=("aur/$pkg"); done
  yay -S --noconfirm --needed -- "${targets[@]}" || return 1
  for pkg in "$@"; do
    if ! pacman -Q -- "$pkg" &>/dev/null; then
      printf '\033[31mError: Package %s did not install\033[0m\n' "$pkg" >&2
      return 1
    fi
  done
}

kind_for() {
  kind_var "$1"
  printf '%s' "$KIND"
}

# The version an install or update of the tool brings, in the global VERSION (no subshell): the repo's
# build for a repo tool, the AUR's for an AUR tool ($2, the catalog's column). Sets KIND too. A repo tool
# is never measured against the AUR: its package comes from the repo whatever the AUR has.
version_var() {
  local pkg=${PKGS_OF[$1]:-$1-bin}
  kind_var "$1"
  if [[ $KIND == repo ]]; then
    load_sync
    VERSION=${SYNC_VERSION[${pkg%% *}]:-}
  else
    VERSION=${2:-}
  fi
  return 0
}

# --- the repos as they are now ---------------------------------------------------------------------
# The system's package lists are as old as its last update, so they never show that a repo has a newer
# build of a tool: Omarchy's repo shipped GridCraft 0.17.0 while the lists still said 0.16.1. checkupdates
# (pacman-contrib; Omarchy's own update indicator runs it) refreshes a private copy of the lists, without
# root and without touching the system's, and the catalog's packages are read from that copy into
# REPO_LATEST. Part of every check (network); a failed check keeps the previous answer.
declare -A LATEST_VERSION=()
LATEST_LOADED=0

repo_check() {
  local id pkg pkgs=() rc=0 table tmp
  command -v checkupdates >/dev/null || return 0
  while IFS=$'\t' read -r id _; do
    [[ $id =~ ^[a-z0-9-]+$ ]] || continue
    pkg=${PKGS_OF[$id]:-$id-bin}
    pkgs+=("${pkg%% *}")
  done <"$CATALOG"
  (( ${#pkgs[@]} > 0 )) || return 0
  mkdir -p "$REPO_DB"
  # 0: updates listed, 2: none; anything else means the copy was not refreshed. timeout signals the whole
  # process group, so pacman's download stops with checkupdates (124 or 137 when the deadline hits).
  CHECKUPDATES_DB="$REPO_DB" timeout --kill-after=10 "$REPO_CHECK_SECONDS" checkupdates --nocolor >/dev/null 2>&1 || rc=$?
  (( rc == 0 || rc == 2 )) || return 1
  table=$(sync_table --dbpath "$REPO_DB" "${pkgs[@]}") || return 1
  tmp=$(mktemp "$REPO_LATEST.XXXXXX")
  printf '%s\n' "$table" >"$tmp" && mv -f "$tmp" "$REPO_LATEST"
  LATEST_LOADED=0
  LATEST_VERSION=()
}

load_latest() {
  (( LATEST_LOADED )) && return 0
  LATEST_LOADED=1
  local pkg repo version
  [[ -f $REPO_LATEST ]] || return 0
  while IFS=$'\t' read -r pkg repo version; do
    [[ $pkg =~ ^[A-Za-z0-9@._+-]{1,128}$ && $version =~ $VERSION_RE ]] || continue
    LATEST_VERSION[$pkg]=$version
  done <"$REPO_LATEST"
}

# The version an update of an installed tool reaches, in VERSION: for an AUR tool the AUR's ($2); for a
# repo tool the newer of the system's lists and its repo as it is now, since Omarchy's update refreshes the
# lists before it upgrades. Sets KIND too. An install still brings what version_var says.
upgrade_var() {
  local pkg=${PKGS_OF[$1]:-$1-bin} latest
  version_var "$1" "${2:-}"
  [[ $KIND == repo ]] || return 0
  load_latest
  latest=${LATEST_VERSION[${pkg%% *}]:-}
  [[ -n $latest && $latest != "$VERSION" ]] || return 0
  if [[ -z $VERSION ]] || (( $(vercmp "$VERSION" "$latest") < 0 )); then VERSION=$latest; fi
  return 0
}

# True when a repo tool updates alone: its package comes from one of the APP_REPOS_RE repos.
updates_alone() {
  local pkg=${PKGS_OF[$1]:-$1-bin}
  load_sync
  [[ ${SYNC_REPO[${pkg%% *}]:-} =~ $APP_REPOS_RE ]]
}

# pacman will require a valid signature on a package installed from a URL: RemoteFileSigLevel, or SigLevel,
# which it defaults to, says PackageRequired (pacman-conf prefixes each level with Package or Database;
# DatabaseOptional is about the package lists, not the packages). Anything else, or an answer this does
# not recognise, counts as no.
remote_signatures_required() {
  local level
  level=" $(pacman-conf RemoteFileSigLevel 2>/dev/null | tr '\n' ' ') "
  [[ -n ${level// /} ]] || level=" $(pacman-conf SigLevel 2>/dev/null | tr '\n' ' ') "
  [[ $level == *" PackageRequired "* ]]
}

# Update packages from an app repo alone, without Omarchy's whole update. The private copy of the package
# lists is refreshed (repo_check) and pacman resolves the update against it: it goes ahead only when
# nothing but the named packages would change, so the system's own lists and every other package stay as
# they are. Each package is then installed from its repo's https address, pacman checking its signature,
# through the AUR helper Omarchy ships, which asks for the password. What remains is a new build that
# needs a newer library without declaring it: only that app would be affected, until the next full update.
repo_update() {
  local out err name url want=" $* " urls=() extra=()
  if ! remote_signatures_required; then
    printf '\nNothing was updated: this system does not require signatures on packages installed from a URL.\n'
    printf 'Update with Omarchy instead: omarchy update\n'
    return 1
  fi
  if ! repo_check; then
    printf '\nNothing was updated: the repos could not be read just now. Try again in a moment.\n'
    return 1
  fi
  mkdir -p "$REPO_DB/no-cache"   # empty: pacman then prints the repo's address, never a cached file
  err=$(mktemp)
  out=$(LC_ALL=C pacman -Sp --needed --dbpath "$REPO_DB" --cachedir "$REPO_DB/no-cache" \
    --print-format '%n %l' -- "$@" 2>"$err") || { cat "$err"; rm -f "$err"; return 1; }
  rm -f "$err"
  while read -r name url; do
    [[ -n $name ]] || continue
    if [[ $want != *" $name "* ]]; then extra+=("$name"); continue; fi
    [[ $url =~ ^https://[^[:space:]]+$ ]] || { printf '\nNothing was updated: %s would come from %s, not an https address.\n' "$name" "$url"; return 1; }
    urls+=("$url")
  done <<<"$out"
  if (( ${#extra[@]} > 0 )); then
    printf '\nNothing was updated. %s also needs %s from the repos, which makes it a system update.\n' "$*" "${extra[*]}"
    printf 'Omarchy'"'"'s update brings them together: omarchy update\n'
    notify "Not updated alone" "$* needs ${extra[*]} too. Omarchy's update brings them together."
    return 4
  fi
  if (( ${#urls[@]} == 0 )); then
    printf '\n%s: already the newest build.\n' "$*"
    return 0
  fi
  yay -U --noconfirm "${urls[@]}"
}

# Every package of a tool, space-separated; the app's own first.
pkgs_for() {
  printf '%s' "${PKGS_OF[$1]:-$1-bin}"
}

# The app's own package: what decides installed, version and update.
pkg_for() {
  local pkgs
  pkgs=$(pkgs_for "$1")
  printf '%s' "${pkgs%% *}"
}

# One read of the installed packages per run: name -> version.
declare -A INSTALLED=()
INSTALLED_LOADED=0

load_installed() {
  (( INSTALLED_LOADED )) && return 0
  local name version
  while read -r name version; do
    INSTALLED[$name]=$version
  done < <(pacman -Q 2>/dev/null)
  INSTALLED_LOADED=1
}

# A source build of a Craft app (pkgname <id>) counts as installed too. Not for tools with their own
# package list: a package named like the tool may be a different program.
installed_pkg() {
  load_installed
  if [[ -n ${INSTALLED[$(pkg_for "$1")]:-} ]]; then
    pkg_for "$1"
  elif [[ -z ${PKGS_OF[$1]:-} && -n ${INSTALLED[$1]:-} ]]; then
    printf '%s' "$1"
  else
    return 1
  fi
}

is_installed() {
  installed_pkg "$1" >/dev/null
}

installed_version() {
  local pkg
  load_installed
  pkg=$(installed_pkg "$1") || return 0
  printf '%s' "${INSTALLED[$pkg]}"
}

# "bin", "repo", "source" or "" for an app. A source build (package <id>) stays "source" even when a repo
# ships the -bin package: only the way it was built can update or remove it.
install_source() {
  local pkg
  pkg=$(installed_pkg "$1" 2>/dev/null) || return 0
  kind_var "$1"
  if [[ $pkg != "$(pkg_for "$1")" ]]; then
    printf source
  elif [[ $KIND == repo ]]; then
    if updates_alone "$1"; then printf bin; else printf repo; fi
  elif [[ $pkg == *-bin ]]; then
    printf bin
  else
    printf source
  fi
}

# A build newer than the installed one exists: the AUR's for an AUR app ($2, the catalog's column), its
# repo's for a repo app (upgrade_var), which Omarchy's update then installs.
update_ready() {
  local id="$1" current src
  src=$(install_source "$id")
  upgrade_var "$id" "${2:-}"
  [[ -n $VERSION && ( $src == bin || $src == repo ) ]] || return 1
  current=$(installed_version "$id")
  [[ -n $current ]] && (( $(vercmp "$current" "$VERSION") < 0 ))
}

# --- catalog ----------------------------------------------------------------------------------

# Parse the SUITE array of the official launcher: id, name, tagline, group and the three brand colours
# (surface, ink on light, ink on dark) of each app(…) call. Two layouts are read: the one before
# 2026-11-06 (each argument on its own line, an AppGroup:: argument) and the one since (one-line
# app("id", "Name", "Tagline", [[…]], "owner/repo") records, no group, and a community app written as
# CraftApp { kind: AppKind::Community, …, ..app(…) }). The whole call, from app( to its closing bracket,
# is read as one record; brackets inside quoted strings do not count. The group is the AppGroup when the
# record has one, "community" inside a CraftApp block of kind Community, "suite" otherwise. A record is
# kept only when every field is well formed and within bounds (no control characters, NAME_MAX and
# TAGLINE_MAX), and at most MAX_APPS are.
parse_upstream_catalog() {
  awk -v max_apps="$MAX_APPS" -v name_max="$NAME_MAX" -v tagline_max="$TAGLINE_MAX" '
    function ok(v, max) { return length(v) > 0 && length(v) <= max && v !~ /[[:cntrl:]]/ }
    function strip(s) { gsub(/"([^"\\]|\\.)*"/, "", s); return s }
    function flush(   s, n, f, bare, grp, k, hex) {
      in_rec = 0
      if (length(rec) > 4096 || kept >= max_apps) return
      s = rec; n = 0
      while (n < 3 && match(s, /"([^"\\]|\\.)*"/)) {
        f[++n] = substr(s, RSTART + 1, RLENGTH - 2)
        s = substr(s, RSTART + RLENGTH)
      }
      bare = strip(rec)
      grp = ""
      if (match(bare, /AppGroup::[A-Za-z]+/)) grp = tolower(substr(bare, RSTART + 10, RLENGTH - 10))
      if (grp == "") grp = community ? "community" : "suite"
      k = 0; hex = ""
      while (k < 9 && match(bare, /0x[0-9a-fA-F][0-9a-fA-F]/)) {
        k++
        hex = hex ((k == 1 || k == 4 || k == 7) ? "\t#" : "") tolower(substr(bare, RSTART + 2, 2))
        bare = substr(bare, RSTART + RLENGTH)
      }
      if (n == 3 && k == 9 && f[1] ~ /^[a-z0-9-]+$/ && length(f[1]) <= 32 && ok(f[2], name_max) \
          && ok(f[3], tagline_max) && length(grp) <= 16) {
        print f[1] "\t" f[2] "\t" f[3] "\t" grp hex
        kept++
      }
    }
    /pub const SUITE/ { in_suite = 1; next }
    !in_suite { next }
    /^\];/ { exit }
    /^[[:space:]]*\/\// { next }
    !in_rec && /CraftApp[[:space:]]*\{/ { in_struct = 1; community = 0 }
    in_struct && !in_rec && /AppKind::Community/ { community = 1 }
    {
      part = ""
      if (in_rec) part = $0
      else if (match($0, /(^|[^A-Za-z0-9_])app\(/)) {
        part = substr($0, RSTART); sub(/^[^a]*/, "", part)
        in_rec = 1; rec = ""; depth = 0
      }
      if (in_rec) {
        rec = rec " " part
        t = strip(part)
        depth += gsub(/\(/, "(", t) - gsub(/\)/, ")", t)
        if (depth <= 0) flush()
      }
    }
    !in_rec && in_struct && /^[[:space:]]*\},?[[:space:]]*$/ { in_struct = 0; community = 0 }
  '
}

# A download of at most $1 bytes, printed whole or not at all: curl stops at a larger declared size, and
# a longer or endless answer is cut after one byte too many and refused, so it never fills memory. The
# other arguments are curl's.
fetch_bounded() {
  local max=$1 out
  shift
  out=$(curl -fsSL --max-filesize "$max" "$@" | head -c $((max + 1))) || return 1
  (( $(printf '%s' "$out" | wc -c) <= max )) || return 1
  printf '%s\n' "$out"
}

# Dependencies the named AUR packages declare that are neither installed nor in the Arch repos: the AUR
# helper would build those from source, which OmarCraft never does. One per line; nothing when the AUR
# cannot be asked (the install itself then fails on the network, as before).
aur_source_deps() {
  local args=() pkg json dep
  for pkg in "$@"; do args+=(--data-urlencode "arg[]=$pkg"); done
  json=$(fetch_bounded "$AUR_MAX_BYTES" --max-time 15 -G "$AUR_RPC" "${args[@]}") || return 0
  jq -e .results <<<"$json" >/dev/null || return 0
  while read -r dep; do
    dep=${dep%%[<>=]*}
    [[ $dep =~ ^[A-Za-z0-9@._+-]{1,128}$ ]] || continue
    pacman -T -- "$dep" >/dev/null && continue
    pacman -Si -- "$dep" >/dev/null 2>&1 && continue
    printf '%s\n' "$dep"
  done < <(jq -r '.results[] | (.Depends // [])[] | strings' <<<"$json" | sort -u | head -n 256)
}

# Stop a job before the AUR helper runs when it would compile a dependency.
refuse_source_builds() {
  local deps
  deps=$(aur_source_deps "$@")
  [[ -z $deps ]] && return 0
  deps=$(paste -sd ' ' <<<"$deps")
  printf '\nNothing was installed. %s needs %s, which the Arch repos do not ship: the AUR helper would\n' "$*" "$deps"
  printf 'build it from source, and OmarCraft only installs prebuilt packages. This waits for the package to be fixed.\n'
  notify "Not installed" "$* needs $deps, which would have to be compiled. OmarCraft only installs prebuilt packages."
  return 3
}

# The AUR's version of each tool among the ids that is not pinned to a repo, as id<TAB>version. The AUR
# -bin build is what installs from the AUR, so it (not the GitHub tag) defines "latest" there. Tools a
# repo ships are asked too: their AUR version is then at hand on the day the repo stops shipping them.
# Fails when the AUR does not answer; an answer that lacks a package means it has no AUR build.
aur_versions() {
  local args=() id pkg json name version
  local -A id_of=()
  for id in "$@"; do
    [[ $id =~ ^[a-z0-9-]+$ && -z ${KIND_OF[$id]:-} ]] || continue
    pkg=${PKGS_OF[$id]:-$id-bin}
    pkg=${pkg%% *}
    id_of[$pkg]=$id
    args+=(--data-urlencode "arg[]=$pkg")
  done
  (( ${#args[@]} > 0 )) || return 0
  json=$(fetch_bounded "$AUR_MAX_BYTES" --max-time 15 -G "$AUR_RPC" "${args[@]}") || return 1
  # An error comes back as type "error", with an empty results list.
  jq -e '.type != "error" and (.results | type == "array")' <<<"$json" >/dev/null 2>&1 || return 1
  while IFS=$'\t' read -r name version; do
    [[ -n ${id_of[$name]:-} && $version =~ $VERSION_RE ]] && printf '%s\t%s\n' "${id_of[$name]}" "$version"
  done < <(jq -r '.results[] | "\(.Name)\t\(.Version)"' <<<"$json")
  return 0
}

catalog_fresh() {
  [[ -s $CATALOG ]] && [[ -z $(find "$CATALOG" -mmin +"$CATALOG_MAX_AGE_MINUTES" 2>/dev/null) ]]
}

catalog_age_seconds() {
  [[ -s $CATALOG ]] || { printf -- '-1'; return; }
  printf '%s' $(( $(date +%s) - $(stat -c %Y "$CATALOG") ))
}

# The cache, ready to read: reconciled to the tools this version knows, and refreshed once, at once, when
# an older version wrote it (see CATALOG_FORMAT). The retry backoff of a failed check is dropped with it.
ensure_cache() {
  local format=""
  reconcile_cache
  [[ -f $CATALOG_FORMAT_FILE ]] && format=$(<"$CATALOG_FORMAT_FILE")
  [[ $format == "$CATALOG_FORMAT" ]] && return 0
  touch -d '-2 days' "$CATALOG"
  rm -f "$REFRESH_FAILED"
  printf '%s\n' "$CATALOG_FORMAT" >"$CATALOG_FORMAT_FILE"
}

# First run, no network: the built-in list without versions, so state can answer at once. A cache from
# an older layout (fewer columns) is rebuilt the same way, keeping the versions it knew.
reconcile_cache() {
  mkdir -p "$CACHE_DIR" "$STATE_DIR"
  local id name tagline group color inkl inkd version old="" tmp missing="" extra=""
  if [[ -s $CATALOG ]]; then
    if awk -F'\t' -v n="$CATALOG_COLUMNS" 'NF != n { bad = 1 } END { exit bad }' "$CATALOG"; then
      # Reconcile the cache to the tools this version knows: a built-in tool it gained (an update) is
      # added without a version. A dropped tool beyond ArtCraft (upstream group "extra", e.g.
      # KolourPaint) is removed so it leaves the panel at once, without waiting for a network refresh.
      # An unknown Craft app (classic/new) is kept — the authoritative upstream catalog may list more
      # Craft apps than this version's built-in fallback. Known tools keep the versions the cache has.
      missing=$(comm -23 <(builtin_rows | cut -f1 | sort) <(cut -f1 "$CATALOG" | sort))
      extra=$(awk -F'\t' 'NR == FNR { known[$1]; next } $4 == "extra" && !($1 in known) { print $1 }' \
        <(builtin_rows) "$CATALOG")
      [[ -n $missing || -n $extra ]] || return 0
      tmp=$(mktemp)
      awk -F'\t' 'NR == FNR { known[$1]; next } ($1 in known) || $4 != "extra"' <(builtin_rows) "$CATALOG" >"$tmp"
      while IFS=$'\t' read -r id name tagline group color inkl inkd; do
        grep -qx "$id" <<<"$missing" || continue
        printf '%s\t%s\t%s\t%s\t\t%s\t%s\t%s\n' "$id" "$name" "$tagline" "$group" "$color" "$inkl" "$inkd" >>"$tmp"
      done < <(builtin_rows)
      mv "$tmp" "$CATALOG"
      AUR_LOADED=0
      AUR_OF=()
      # A new tool has no version yet; make the cache stale so the next state read fetches it.
      [[ -n $missing ]] && touch -d '-2 days' "$CATALOG"
      return 0
    fi
    old=$(cut -f1,5 "$CATALOG")
  fi
  tmp=$(mktemp)
  while IFS=$'\t' read -r id name tagline group color inkl inkd; do
    version=$(awk -F'\t' -v id="$id" '$1 == id { print $2 }' <<<"$old")
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$name" "$tagline" "$group" "$version" "$color" "$inkl" "$inkd"
  done < <(builtin_rows) >"$tmp"
  mv "$tmp" "$CATALOG"
  AUR_LOADED=0
  AUR_OF=()
  # No versions yet: stale on purpose, so the first state read starts a refresh right away.
  touch -d '-2 days' "$CATALOG"
  # Nothing has been seen yet; the first real catalog must not notify fourteen "new" apps.
  [[ -f $SEEN ]] || cut -f1 "$CATALOG" >"$SEEN"
}

# Rows of the cache with fields separated by \x1f, not tab: tab is IFS whitespace, so `read`
# collapses an empty version column and the colours shift into it. \x1f never collapses.
catalog_rows() {
  ensure_cache
  tr '\t' '\037' <"$CATALOG"
}

# Network. Keeps the old data when the AUR cannot be reached: a failed check is never "up to date".
refresh() {
  local force="${1:-}" upstream versions id name tagline group color inkl inkd version new_names=()
  ensure_cache

  if [[ $force != "-f" ]] && catalog_fresh && [[ ! -f $REFRESH_FAILED ]]; then
    return 0
  fi

  local raw
  raw=$(fetch_bounded "$CATALOG_MAX_BYTES" --max-time 10 "$CATALOG_URL" 2>/dev/null || true)
  upstream=""
  if [[ -n $raw ]]; then
    upstream=$(parse_upstream_catalog <<<"$raw" || true)
    # A list that downloaded and holds no app this parser can read is a failure, not a quiet fallback
    # (2026-11-06: a new layout went unnoticed for three days).
    if [[ -z $upstream ]]; then now_iso >"$PARSE_FAILED"; else rm -f "$PARSE_FAILED"; fi
  fi
  [[ -n $upstream ]] || upstream="$BUILTIN_CATALOG"
  upstream+=$'\n'"$EXTRA_CATALOG"

  # The version column is the AUR's, for every tool; what the repos ship is read from the sync databases
  # when it is needed. A check fails only when the AUR does not answer, never because nothing in it is
  # newer or because every tool comes from a repo.
  # shellcheck disable=SC2046
  if ! versions=$(aur_versions $(cut -f1 <<<"$upstream")); then
    now_iso >"$REFRESH_FAILED"
    return 1
  fi

  local tmp
  tmp=$(mktemp)
  while IFS=$'\t' read -r id name tagline group color inkl inkd; do
    [[ $id =~ ^[a-z0-9-]+$ ]] || continue
    version=$(awk -F'\t' -v id="$id" '$1 == id { print $2 }' <<<"$versions")
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$name" "$tagline" "${group:-new}" "$version" \
      "${color:-}" "${inkl:-}" "${inkd:-}" >>"$tmp"
  done <<<"$upstream"
  mv "$tmp" "$CATALOG"
  AUR_LOADED=0
  AUR_OF=()
  rm -f "$REFRESH_FAILED"
  repo_check || true

  while IFS=$'\t' read -r id name _ _ _; do
    grep -qx "$id" "$SEEN" || new_names+=("$name")
  done <"$CATALOG"
  if (( ${#new_names[@]} > 0 )); then
    notify -g "$ICON_NEW" "New in OmarCraft" "${new_names[*]}" --exec omarchy-shell "$IPC_TARGET" open
  fi
}

# A refresh in the background, at most one at a time, never longer than REFRESH_DEADLINE_SECONDS; the panel
# is poked when it ends. The lock holds the wrapper's pid, so the deadline also bounds how long it can stop
# the next refresh.
refresh_detached() {
  local pid
  if [[ -f $REFRESH_LOCK ]]; then
    pid=$(cat "$REFRESH_LOCK" 2>/dev/null || true)
    [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null && return 0
  fi
  (
    setsid bash -c '
      printf "%s" "$$" >"$1"
      timeout --kill-after=10 "$4" "$2" refresh "$3" >/dev/null 2>&1
      rm -f "$1"
      "$2" poke
    ' _ "$REFRESH_LOCK" "$SELF" "${1:-}" "$REFRESH_DEADLINE_SECONDS" >/dev/null 2>&1 </dev/null &
  )
}

refreshing() {
  local pid
  [[ -f $REFRESH_LOCK ]] || return 1
  pid=$(cat "$REFRESH_LOCK" 2>/dev/null || true)
  [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null
}

# True when the panel may retry a failed check on its own: no failure recorded, or one older than
# REFRESH_RETRY_MINUTES. A manual check (-f) never waits. Without this an offline machine looped:
# every state read started a refresh, every failed refresh poked the panel, which read the state
# again, and the reads killed one another.
refresh_due() {
  [[ -f $REFRESH_FAILED ]] || return 0
  [[ -n $(find "$REFRESH_FAILED" -mmin +"$REFRESH_RETRY_MINUTES" 2>/dev/null) ]]
}

app_name() {
  local name
  name=$(awk -F'\t' -v id="$1" '$1 == id { print $2 }' "$CATALOG" 2>/dev/null)
  printf '%s' "${name:-$1}"
}

aur_version() {
  awk -F'\t' -v id="$1" '$1 == id { print $5 }' "$CATALOG" 2>/dev/null
}

is_new() {
  [[ -f $SEEN ]] && ! grep -qx "$1" "$SEEN"
}

mark_seen() {
  mkdir -p "$STATE_DIR"
  grep -qx "$1" "$SEEN" 2>/dev/null || echo "$1" >>"$SEEN"
}

# Every catalog id at once: the panel was open, so nothing in it is new any more.
mark_all_seen() {
  local id tmp
  ensure_cache
  while read -r id; do
    [[ -n $id ]] && mark_seen "$id"
  done < <(cut -f1 "$CATALOG")
  # The last job, shown in the panel that is now closing, is acknowledged: a failed one stops being
  # flagged by the panel and the bar icon, a successful update stops showing its summary line. The next
  # job is shown again (end_job writes a fresh record).
  if [[ -f $LAST_JOB_FILE ]] && jq -e '.seen | not' "$LAST_JOB_FILE" >/dev/null 2>&1; then
    tmp=$(mktemp "$LAST_JOB_FILE.XXXXXX")
    jq -c '.seen = true' "$LAST_JOB_FILE" >"$tmp" && mv -f "$tmp" "$LAST_JOB_FILE" || rm -f "$tmp"
  fi
}

# Ids of a group that have a package to install, from a repo or the AUR: all, creative, 3d or office
# (notes: office).
group_ids() {
  local group="$1" id name tagline ugroup version
  [[ $group =~ $GROUPS_RE ]] || die "unknown group: $group (all, creative, 3d or office)"
  [[ $group == notes ]] && group=office
  load_sync
  while IFS=$'\037' read -r id name tagline ugroup version _; do
    version_var "$id" "$version"
    [[ -n $VERSION ]] || continue
    [[ $group == all || ${GROUP_OF[$id]:-creative} == "$group" ]] && echo "$id"
  done < <(catalog_rows)
  return 0
}

missing_ids() {
  local id
  load_installed
  load_sync
  while read -r id; do
    is_installed "$id" || echo "$id"
  done < <(group_ids "${1:-all}")
}

# Installed apps with a newer build that update alone (AUR apps and Omarchy's repo apps: what Update all
# updates), or with "repo" the ones that update with the system (the Arch repos).
outdated_ids() {
  local want="${1:-bin}" id name tagline group version
  load_installed
  load_sync
  while IFS=$'\037' read -r id name tagline group version _; do
    update_ready "$id" "$version" && [[ $(install_source "$id") == "$want" ]] && echo "$id"
  done < <(catalog_rows)
  return 0
}

# --- jobs ----------------------------------------------------------------------------------------
# A job is one terminal run. job.json exists while it runs; last-job.json records how it ended.

write_job() {
  local verb="$1"
  shift
  mkdir -p "$STATE_DIR"
  jq -nc --arg verb "$verb" --arg started "$(now_iso)" --argjson pid "$$" --args '
    {verb: $verb, ids: $ARGS.positional, startedAt: $started, pid: $pid}' "$@" >"$JOB_FILE"
}

end_job() {
  local rc="$1"
  if [[ -f $JOB_FILE ]]; then
    jq -c --argjson exit "$rc" --arg ended "$(now_iso)" '{verb, ids, exit: $exit, endedAt: $ended}
      + (if $exit == 130 then {interrupted: true} else {} end)' \
      "$JOB_FILE" >"$LAST_JOB_FILE" 2>/dev/null || true
    rm -f "$JOB_FILE"
  fi
  (( rc == 0 )) && rm -f "$NOTIFIED"
  poke_panel
}

# A job whose process is gone did not end through end_job: record it as interrupted.
reconcile_job() {
  local pid
  [[ -f $JOB_FILE ]] || return 0
  pid=$(jq -r '.pid // empty' "$JOB_FILE" 2>/dev/null || true)
  if [[ -z $pid ]] || ! kill -0 "$pid" 2>/dev/null; then
    jq -c --arg ended "$(now_iso)" '{verb, ids, exit: 130, interrupted: true, endedAt: $ended}' \
      "$JOB_FILE" >"$LAST_JOB_FILE" 2>/dev/null || true
    rm -f "$JOB_FILE"
  fi
}

# Runs inside the floating terminal. Exit status is the package command's.
job() {
  local verb="${1:-}" id pkg pkgs=() repo_pkgs=() aur_pkgs=() shadowed=() own=()
  shift || true
  load_sync
  case "$verb" in
    install)
      (( $# > 0 )) || die "usage: omarcraft job install <id>..."
      for id in "$@"; do
        known_id "$id"
        read -ra own <<<"$(pkgs_for "$id")"
        kind_var "$id"
        if [[ $KIND == repo ]]; then
          repo_pkgs+=("${own[@]}")
        else
          for pkg in "${own[@]}"; do
            if [[ -n ${SYNC_REPO[$pkg]:-} ]]; then shadowed+=("$pkg"); else aur_pkgs+=("$pkg"); fi
          done
        fi
      done
      ;;
    update)
      if (( $# == 0 )); then
        mapfile -t ids < <(outdated_ids)
        set -- "${ids[@]}"
      fi
      (( $# > 0 )) || die "nothing to update"
      for id in "$@"; do
        known_id "$id"
        read -ra own <<<"$(pkgs_for "$id")"
        kind_var "$id"
        if [[ $KIND == aur ]]; then
          pkgs+=("${own[@]}")
        elif updates_alone "$id"; then
          repo_pkgs+=("${own[@]}")
        else
          die "$id comes from a package repo and updates with the system: omarcraft update $id"
        fi
      done
      ;;
    system-update)
      for id in "$@"; do known_id "$id"; done
      ;;
    remove)
      (( $# > 0 )) || die "usage: omarcraft job remove <id>..."
      for id in "$@"; do
        known_id "$id"
        read -ra own <<<"$(pkgs_for "$id")"
        pkgs+=("${own[@]}")
      done
      ;;
    *) die "usage: omarcraft job <install|update|system-update|remove> [id...]" ;;
  esac

  write_job "$verb" "$@"
  trap 'rc=$?; trap - EXIT; end_job $rc; exit $rc' EXIT
  # Closing the terminal (a hangup), Ctrl+C or a kill ends the job early. Untrapped, bash would run the EXIT
  # trap with the status of the last step that had finished, and a cut-off job would read as a success.
  trap 'exit 130' HUP INT TERM
  case "$verb" in
    install)
      # Explicit returns: the status of a failed install must reach end_job even without set -e.
      if (( ${#repo_pkgs[@]} > 0 )); then omarchy-pkg-add "${repo_pkgs[@]}" || return; fi
      if (( ${#aur_pkgs[@]} + ${#shadowed[@]} > 0 )); then refuse_source_builds "${aur_pkgs[@]}" "${shadowed[@]}" || return; fi
      if (( ${#aur_pkgs[@]} > 0 )); then omarchy-pkg-aur-add "${aur_pkgs[@]}" || return; fi
      if (( ${#shadowed[@]} > 0 )); then aur_install_shadowed "${shadowed[@]}" || return; fi
      ;;
    # Package-exact update: Omarchy's own AUR updater takes every AUR package, so the helper is called
    # directly here. It is the helper Omarchy ships and uses itself.
    update)
      if (( ${#repo_pkgs[@]} > 0 )); then repo_update "${repo_pkgs[@]}" || return; fi
      if (( ${#pkgs[@]} > 0 )); then
        refuse_source_builds "${pkgs[@]}" || return
        own=()
        for pkg in "${pkgs[@]}"; do own+=("$(aur_target "$pkg")"); done
        yay -S --noconfirm "${own[@]}" || return
      fi
      ;;
    # Repo packages are never updated one by one (a partial upgrade); Omarchy updates them all.
    system-update) omarchy-update ;;
    # Removal is Omarchy's own command: the package and the dependencies nothing else needs. The
    # app's documents and settings are not touched.
    remove)
      omarchy-pkg-drop "${pkgs[@]}"
      ;;
  esac
}

# Open the floating Omarchy terminal on a job. $then_launch: id to launch after a successful install.
run_job() {
  local verb="$1" then_launch="$2" names=() id self message after=""
  shift 2
  for id in "$@"; do
    mark_seen "$id"
    names+=("$(app_name "$id")")
  done
  [[ -f $JOB_FILE ]] && reconcile_job
  [[ -f $JOB_FILE ]] && die "a job is already running: $(jq -r '.verb + " " + (.ids | join(" "))' "$JOB_FILE")"

  printf -v self '%q' "$SELF"
  case "$verb" in
    install) printf -v message '%q' "Installing ${names[*]}..." ;;
    update) printf -v message '%q' "Updating ${names[*]}..." ;;
    system-update) printf -v message '%q' "${names[*]} update with the system: running Omarchy's update..." ;;
    remove) printf -v message '%q' "Removing ${names[*]}..." ;;
  esac
  [[ -n $then_launch ]] && after=" && (setsid ${self} launch ${then_launch} >/dev/null 2>&1 &)"
  exec omarchy-launch-floating-terminal-with-presentation \
    "echo ${message}; ${self} job ${verb} $*${after}"
}

# --- actions ----------------------------------------------------------------------------------

desktop_id_for() {
  local file
  [[ -n ${DESKTOP_OF[$1]:-} ]] && { printf '%s' "${DESKTOP_OF[$1]}"; return; }
  file=$(pacman -Qlq "$(installed_pkg "$1")" 2>/dev/null | grep -m1 '/usr/share/applications/.*\.desktop$' || true)
  if [[ -n $file ]]; then
    basename "$file" .desktop
  else
    printf 'ai.storyteller.%s' "$1"
  fi
}

# The window classes an app's window can carry: its desktop id (the Wayland app id) and the entry's
# StartupWMClass.
window_classes_for() {
  local desktop file
  desktop=$(desktop_id_for "$1")
  printf '%s\n' "$desktop"
  for file in "$DATA_HOME/applications/$desktop.desktop" "/usr/share/applications/$desktop.desktop"; do
    [[ -f $file ]] && sed -n 's/^StartupWMClass=//p' "$file" | head -1
  done
}

# Focus the app's open window, or run the launch command. Matches the window class exactly, never the
# title: omarchy-launch-or-focus also matches titles, so a terminal or a browser tab titled with an
# app's name was focused instead of opening the app.
launch_or_focus() {
  local id=$1 command=$2 classes address
  classes=$(window_classes_for "$id" | jq -R 'ascii_downcase | select(. != "")' | jq -sc .)
  address=$(hyprctl clients -j 2>/dev/null \
    | jq -r --argjson classes "$classes" 'first(.[] | select(.class | ascii_downcase | IN($classes[]))) | .address' 2>/dev/null || true)
  if [[ -n $address ]]; then
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1 \
      || hyprctl dispatch focuswindow "address:$address" >/dev/null
    exit 0
  fi
  eval exec setsid "$command"
}

launch() {
  local id="$1"
  known_id "$id"
  is_installed "$id" || die "$id is not installed (try: omarcraft install $id)"
  mark_seen "$id"
  launch_or_focus "$id" "uwsm-app -- gtk-launch $(desktop_id_for "$id")"
}

install_apps() {
  local ids=() id
  load_installed
  for id in "$@"; do
    known_id "$id"
    is_installed "$id" || ids+=("$id")
  done
  if (( ${#ids[@]} == 0 )); then
    (( $# == 1 )) && launch "$1"
    notify "Nothing to install"
    exit 0
  fi
  run_job install "$( (( $# == 1 )) && echo "$1")" "${ids[@]}"
}

# Remove apps installed as packages (an AUR -bin or a repo package). An app installed some other way (a
# source build) is left alone with a message: only the path that installed it knows how to undo it.
remove_apps() {
  local ids=() id src
  load_installed
  load_sync
  for id in "$@"; do
    known_id "$id"
    is_installed "$id" || die "$id is not installed"
    src=$(install_source "$id")
    [[ $src == bin || $src == repo ]] || die "$id was not installed as a package by OmarCraft; remove it the way it was installed"
    ids+=("$id")
  done
  run_job remove "" "${ids[@]}"
}

install_group() {
  local ids
  mapfile -t ids < <(missing_ids "${1:-all}")
  if (( ${#ids[@]} == 0 )); then
    notify "Nothing to install"
    exit 0
  fi
  run_job install "" "${ids[@]}"
}

# update [id...]: the given apps, or every installed app with a newer build that updates alone, one
# package each: AUR apps, and apps from Omarchy's repo after a dependency check. Apps from the Arch repos
# open Omarchy's update instead when nothing else is to update: a package from those is never updated on
# its own.
update() {
  local ids=() system=() id
  load_installed
  load_sync
  if (( $# > 0 )); then
    for id in "$@"; do
      known_id "$id"
      kind_var "$id"
      if [[ $KIND == repo ]] && ! updates_alone "$id"; then system+=("$id"); else ids+=("$id"); fi
    done
  else
    mapfile -t ids < <(outdated_ids)
    mapfile -t system < <(outdated_ids repo)
  fi
  if (( ${#ids[@]} == 0 && ${#system[@]} > 0 )); then
    run_job system-update "" "${system[@]}"
  fi
  if (( ${#ids[@]} == 0 )); then
    notify "No updates pending"
    exit 0
  fi
  run_job update "" "${ids[@]}"
}

check() {
  local notify_flag="${1:-}" ids names=() plain=() id
  refresh >/dev/null 2>&1 || true
  parse_warning
  load_installed
  load_sync
  ids=$(outdated_ids; outdated_ids repo)
  if [[ -z $ids ]]; then
    rm -f "$NOTIFIED"
    return 1
  fi

  while read -r id; do
    upgrade_var "$id" "$(aur_version "$id")"
    names+=("$(app_name "$id") $(installed_version "$id") → $VERSION")
    plain+=("$(app_name "$id")")
  done <<<"$ids"
  printf '%s\n' "${names[@]}"

  # Notify once per distinct set of pending updates.
  if [[ $notify_flag == "--notify" ]] && [[ $(cat "$NOTIFIED" 2>/dev/null) != "$ids" ]]; then
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$ids" >"$NOTIFIED"
    # Names only, as in the panel: the versions are for the command line.
    notify -g "$ICON_UPDATE" "OmarCraft updates available" "$(printf '%s\n' "${plain[@]}")" \
      --exec omarchy-shell "$IPC_TARGET" open
  fi
  return 0
}

# --- state ------------------------------------------------------------------------------------
# Local only: cache files and the package database. A stale cache starts a detached refresh.

state() {
  local id name tagline ugroup version color inkl inkd src current ready new group glyph pkg kind repo row=0
  local rows="" job="null" last="null" office_json="[]" seen_known=0 office_ids=()
  local -A seen=()
  legacy_vikunja_cleanup
  load_installed
  ensure_cache
  load_sync
  reconcile_job
  if { ! catalog_fresh || [[ -f $REFRESH_FAILED ]]; } && ! refreshing && refresh_due; then
    refresh_detached
  fi
  if [[ -f $SEEN ]]; then
    seen_known=1
    while read -r id; do [[ -n $id ]] && seen[$id]=1; done <"$SEEN"
  fi

  # One pass with no subshell per field: a forked helper for each of them made a read of thirteen
  # installed apps take close to a second, long enough for the next read to collide with it.
  while IFS=$'\037' read -r id name tagline ugroup version color inkl inkd; do
    # Bounded again on the way out, whatever wrote the cache: the panel reads all of this output, inside
    # the shell that draws the whole bar.
    (( ++row <= MAX_APPS + 8 )) || break
    [[ $id =~ ^[a-z0-9-]{1,32}$ ]] || continue
    name=${name:0:NAME_MAX}
    tagline=${tagline:0:TAGLINE_MAX}
    [[ $ugroup =~ ^[a-z]{0,16}$ ]] || ugroup=""
    [[ $color =~ $COLOR_RE ]] || color=""
    [[ $inkl =~ $COLOR_RE ]] || inkl=""
    [[ $inkd =~ $COLOR_RE ]] || inkd=""
    pkg=${PKGS_OF[$id]:-$id-bin}
    pkg=${pkg%% *}
    # A repo tool shows and compares the repo's build, never the AUR's: the repo's is what installs, and,
    # once installed, what its repo ships now is what Omarchy's update brings.
    if [[ -n ${INSTALLED[$pkg]:-} ]]; then upgrade_var "$id" "$version"; else version_var "$id" "$version"; fi
    kind=$KIND
    version=$VERSION
    [[ -z $version || $version =~ $VERSION_RE ]] || version=""
    repo=""
    [[ $kind == repo ]] && repo=${SYNC_REPO[$pkg]:-}
    if [[ -n ${INSTALLED[$pkg]:-} ]]; then
      current=${INSTALLED[$pkg]}
      if [[ $kind == repo && ! $repo =~ $APP_REPOS_RE ]]; then src=repo; elif [[ $kind == repo || $pkg == *-bin ]]; then src=bin; else src=source; fi
    elif [[ -z ${PKGS_OF[$id]:-} && -n ${INSTALLED[$id]:-} ]]; then src=source; current=${INSTALLED[$id]}
    else src=""; current=""; fi
    ready=0
    if [[ ( $src == bin || $src == repo ) && -n $version && $current != "$version" ]] && (( $(vercmp "$current" "$version") < 0 )); then ready=1; fi
    new=0
    (( seen_known )) && [[ -z ${seen[$id]:-} ]] && new=1
    group=${GROUP_OF[$id]:-creative}
    [[ $group == office && -n $version ]] && office_ids+=("$id")
    glyph=${APP_ICON[$id]:-$ICON_ARTCRAFT}
    rows+="$id"$'\t'"$name"$'\t'"$tagline"$'\t'"$group"$'\t'"$ugroup"$'\t'"$glyph"$'\t'
    rows+="$version"$'\t'"$current"$'\t'"$src"$'\t'"$ready"$'\t'"$new"$'\t'"${DESKTOP_OF[$id]:-ai.storyteller.$id}"$'\t'
    rows+="$color"$'\t'"$inkl"$'\t'"$inkd"$'\t'"$kind"$'\t'"$repo"$'\n'
  done < <(catalog_rows)
  (( ${#office_ids[@]} )) && office_json=$(printf '%s\n' "${office_ids[@]}" | jq -Rn '[inputs]')

  [[ -f $JOB_FILE ]] && job=$(jq -c . "$JOB_FILE" 2>/dev/null || echo null)
  [[ -f $LAST_JOB_FILE ]] && last=$(jq -c . "$LAST_JOB_FILE" 2>/dev/null || echo null)

  jq -Rn \
    --arg generated "$(now_iso)" \
    --argjson age "$(catalog_age_seconds)" \
    --argjson offline "$([[ -f $REFRESH_FAILED ]] && echo true || echo false)" \
    --argjson refreshing "$(refreshing && echo true || echo false)" \
    --argjson job "$job" --argjson last "$last" \
    --argjson office "$office_json" '
    [inputs | select(length > 0) | split("\t") | {
      id: .[0], name: .[1], tagline: .[2], group: .[3], upstreamGroup: .[4], glyph: .[5],
      aurVersion: .[6], installedVersion: .[7],
      installed: (.[8] != ""), source: (if .[8] == "" then null else .[8] end),
      updateReady: (.[9] == "1"), new: (.[10] == "1"), desktopId: .[11],
      color: .[12], inkLight: .[13], inkDark: .[14], kind: .[15], repo: .[16]
    }] as $apps
    | {
        generatedAt: $generated, catalogAgeSeconds: $age, offline: $offline, refreshing: $refreshing,
        counts: {
          installed: ($apps | map(select(.installed)) | length),
          available: ($apps | map(select((.installed | not) and .aurVersion != "")) | length),
          updates: ($apps | map(select(.updateReady)) | length),
          unpackaged: ($apps | map(select((.installed | not) and .aurVersion == "")) | length)
        },
        job: $job, lastJob: $last,
        groups: {office: $office},
        apps: $apps
      }' <<<"$rows"
}

# One line on stderr while ArtCraft's list cannot be read (see PARSE_FAILED).
parse_warning() {
  [[ -f $PARSE_FAILED ]] || return 0
  printf "ArtCraft's app list could not be read since %s (its layout changed?): using the built-in list.\n" \
    "$(cat "$PARSE_FAILED" 2>/dev/null)" >&2
}

list() {
  local id name tagline group version status src where pkg
  parse_warning
  load_installed
  load_sync
  while IFS=$'\037' read -r id name tagline group version _; do
    if is_installed "$id"; then upgrade_var "$id" "$version"; else version_var "$id" "$version"; fi
    version=$VERSION
    pkg=${PKGS_OF[$id]:-$id-bin}
    where="AUR"
    [[ $KIND == repo ]] && where="${SYNC_REPO[${pkg%% *}]:-a} repo"
    if is_installed "$id"; then
      src=$(install_source "$id")
      [[ $src != source && $where != AUR ]] && src=$where
      status="installed $(installed_version "$id") ($src)"
      update_ready "$id" "$version" && status="$status, update ready $version"
    elif [[ -z $version ]]; then
      status="not packaged yet"
    else
      status="available ($where)"
    fi
    is_new "$id" && status="$status, new"
    printf '%-12s %-12s %-9s %-10s %s\n' "$id" "$name" "$(group_for "$id")" "${version:--}" "$status"
  done < <(catalog_rows)
}

# --- what 0.5.0 left for Vikunja --------------------------------------------------------------
# 0.5.0 shipped Vikunja and 0.5.1 dropped it: its desktop app signs in only through the browser, and that
# hand-off kept failing. Where 0.5.0 installed it, it left a desktop entry whose launcher calls a command
# this version no longer has. Remove what OmarCraft wrote, once, and say where the data is. The packages,
# the data folder, a running server and anything the user wrote are left alone.
legacy_vikunja_cleanup() {
  local pid
  if [[ -f $LEGACY_VIKUNJA_PID ]]; then
    pid=$(<"$LEGACY_VIKUNJA_PID")
    if ! [[ $pid =~ ^[0-9]+$ ]] || ! kill -0 "$pid" 2>/dev/null; then rm -f "$LEGACY_VIKUNJA_PID"; fi
  fi
  grep -qx 'X-OmarCraft=true' "$LEGACY_VIKUNJA_ENTRY" 2>/dev/null || return 0
  rm -f "$LEGACY_VIKUNJA_ENTRY" "$LEGACY_VIKUNJA_DIR/launch"
  notify "Vikunja left OmarCraft" "OmarCraft no longer runs Vikunja. Your Vikunja data stays in ~/.local/share/omarcraft/vikunja. To remove the app: omarchy pkg drop vikunja-desktop-bin vikunja-bin"
}

# --- optional Omarchy-menu section -------------------------------------------------------------

json_entry() {
  # key icon label action [when] [description] [aliases]
  jq -nc --arg icon "$2" --arg label "$3" --arg action "$4" --arg when "${5:-}" \
    --arg description "${6:-}" --arg aliases "${7:-}" \
    '{icon: $icon, label: $label}
     + (if $action != "" then {action: $action} else {} end)
     + (if $when != "" then {when: $when} else {} end)
     + (if $description != "" then {description: $description} else {} end)
     + (if $aliases != "" then {aliases: ($aliases | split(" "))} else {} end)' |
    sed "s/^/  \"$1\": /; s/\$/,/"
}

menu_block() {
  local self open
  printf -v self '%q' "$SELF"
  open="omarchy-shell $IPC_TARGET open"
  echo "  // >>> omarcraft (added by 'omarcraft setup-menu'; remove with 'omarcraft remove-menu')"
  json_entry "omarcraft" "$ICON_ARTCRAFT" "OmarCraft" "" "" "The Craft apps and more" "ac omarcraft"
  json_entry "omarcraft.browse" "$ICON_ARTCRAFT" "All tools" "$open" "" "Launch, install, update or remove any tool"
  json_entry "omarcraft.update" "$ICON_UPDATE" "Update all" "$self update" "$self check" "Newer builds of your tools"
  json_entry "omarcraft.install-all" "$ICON_GROUP" "Install all" "$self install-group all" "$self missing all" "Every tool"
  json_entry "omarcraft.install-office" "$ICON_GROUP" "Install Office" "$self install-group office" "$self missing office" \
    "Word, Grid, Deck, PdfCraft, Typesetter, Memospot, Planify"
  json_entry "omarcraft.install-creative" "$ICON_GROUP" "Install Creative" "$self install-group creative" "$self missing creative" \
    "Photo, Vector, Light, Design, Fig, Film, Effect, SoundCraft"
  json_entry "omarcraft.install-3d" "$ICON_GROUP" "Install 3D Art" "$self install-group 3d" "$self missing 3d" \
    "CAD, Solid, Texture, MaterialCraft"
  json_entry "install.omarcraft" "$ICON_ARTCRAFT" "OmarCraft" "$open" "" "Craft apps and more"
  echo "  // <<< omarcraft"
}

strip_block() {
  awk '
    /\/\/ >>> omarcraft/ { skip = 1; next }
    /\/\/ <<< omarcraft/ { skip = 0; next }
    !skip
  ' "$1"
}

setup_menu() {
  local tmp block
  [[ -f $MENU_FILE ]] || { mkdir -p "$(dirname "$MENU_FILE")"; printf '{\n}\n' >"$MENU_FILE"; }
  block=$(mktemp)
  tmp=$(mktemp)
  menu_block >"$block"

  # Insert the fresh block before the final closing brace.
  strip_block "$MENU_FILE" | awk -v blockfile="$block" '
    { lines[++n] = $0 }
    END {
      last = 0
      for (i = n; i > 0; i--) if (lines[i] ~ /^[[:space:]]*}[[:space:]]*$/) { last = i; break }
      for (i = 1; i <= n; i++) {
        if (i == last) while ((getline l < blockfile) > 0) print l
        print lines[i]
      }
    }
  ' >"$tmp"

  cmp -s "$tmp" "$MENU_FILE" || cat "$tmp" >"$MENU_FILE"
  rm -f "$tmp" "$block"
  echo "ArtCraft section added to the Omarchy menu: omarchy menu summon ac"
}

remove_menu() {
  [[ -f $MENU_FILE ]] || return 0
  local tmp
  tmp=$(mktemp)
  strip_block "$MENU_FILE" >"$tmp"
  cmp -s "$tmp" "$MENU_FILE" || cat "$tmp" >"$MENU_FILE"
  rm -f "$tmp"
}

# Sourcing the script (tests) loads the functions without running a command.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  case "${1:-state}" in
    state) state ;;
    launch) launch "${2:?usage: omarcraft launch <id>}" ;;
    install) shift; (( $# > 0 )) || die "usage: omarcraft install <id>..."; install_apps "$@" ;;
    install-group) install_group "${2:-all}" ;;
    remove) shift; (( $# > 0 )) || die "usage: omarcraft remove <id>..."; remove_apps "$@" ;;
    update) shift; update "$@" ;;
    job) shift; job "$@" ;;
    missing) [[ -n $(missing_ids "${2:-all}") ]] ;;
    seen) mark_all_seen ;;
    check) check "${2:-}" ;;
    refresh) refresh "${2:-}" ;;
    poke) poke_panel ;;
    list) list ;;
    # 0.5.0's Vikunja commands: its launcher entry or its panel may call one once more after an update.
    vikunja-session | vikunja-stop | tray-sync) legacy_vikunja_cleanup ;;
    setup-menu) setup_menu ;;
    remove-menu) remove_menu ;;
    -h | --help | help) sed -n '3,24p' "$SELF" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command: $1 (see omarcraft --help)" ;;
  esac
fi
